    {
      "parameters": {
        "jsCode": "// ======================================================\n// PERSONAL INFO\n// ======================================================\nconst name = $node[\"Receiving Answers\"].json.body.name || \"\";\nconst email = $node[\"Receiving Answers\"].json.body.email || \"\";\nconst company =\n  $node[\"Receiving Answers\"].json.body.company ||\n  $node[\"Receiving Answers\"].json.body.business ||\n  $node[\"Receiving Answers\"].json.body.company_name ||\n  $node[\"Receiving Answers\"].json.body.businessName ||\n  $node[\"Receiving Answers\"].json.body.business_name ||\n  \"\";\n// ======================================================\n// RAW INPUTS FROM WEBHOOK\n// ======================================================\nconst body = $json.body || {};\n\n// Accept multiple possible input formats for revenue\nconst annualRevenueRaw =\n  body.annualRevenue ||\n  $json.annualRevenue ||\n  body.annual_revenue ||\n  null;\n\n// Convert \"750,000\" → 750000\nconst annualRevenueNumeric = annualRevenueRaw\n  ? Number(String(annualRevenueRaw).replace(/[^0-9]/g, \"\"))\n  : null;\n\n// Accept multiple input names for hours lost\nconst weeklyLost =\n  Number(body.hours_per_week_lost) ||\n  Number($json.hours_per_week_lost) ||\n  Number($json.weeklyLost) ||\n  null;\n\n// Check for missing inputs\nif (!annualRevenueNumeric || weeklyLost === null || isNaN(weeklyLost)) {\n  return {\n    json: {\n      error: \"Missing or invalid revenue or time-loss data\",\n      annualRevenueRaw,\n      annualRevenueNumeric,\n      weeklyLost,\n      received: $json\n    }\n  };\n}\n\n// ------------------------------------------------------\n// MAP NUMERIC REVENUE → RANGE BUCKET\n// ------------------------------------------------------\nfunction getRevenueRange(num) {\n  if (num < 250000) return \"Under $250K\";\n  if (num < 500000) return \"$250K–$500K\";\n  if (num < 1000000) return \"$500K–$1M\";\n  if (num < 3000000) return \"$1M–$3M\";\n  if (num < 5000000) return \"$3M–$5M\";\n  return \"Over $5M\";\n}\n\nconst revenueRange = getRevenueRange(annualRevenueNumeric);\n\n// Revenue midpoint lookup\nconst revenueMap = {\n  \"Under $250K\": 150000,\n  \"$250K–$500K\": 375000,\n  \"$500K–$1M\": 750000,\n  \"$1M–$3M\": 2000000,\n  \"$3M–$5M\": 4000000,\n  \"Over $5M\": 6000000\n};\n\n// Get mapped revenue\nconst annualRevenue = revenueMap[revenueRange];\n\n// ------------------------------------------------------\n// HOURLY VALUE\n// ------------------------------------------------------\nconst hourlyRate = Number((annualRevenue / 2080).toFixed(2));\n\n// ------------------------------------------------------\n// YEARLY HOURS LOST\n// ------------------------------------------------------\nconst yearlyHours = weeklyLost * 52;\n\n// 40% time recovery\nconst recoveryPct = 0.40;\nconst hoursRecovered = yearlyHours * recoveryPct;\n\n// ------------------------------------------------------\n// SAVINGS\n// ------------------------------------------------------\nconst yearlySavings = hoursRecovered * hourlyRate;\nconst monthlySavings = Number((yearlySavings / 12).toFixed(2));\n\n// ------------------------------------------------------\n// INVESTMENT COST BASED ON NEW SPRINT SYSTEM\n// ------------------------------------------------------\nconst sprint = $json.sprint_recommendation;\n\nlet investmentCost = 6000;\n\nif (sprint === \"Extract\")  investmentCost = 3000;\nif (sprint === \"Organize\") investmentCost = 4500;\nif (sprint === \"Activate\") investmentCost = 6000;\nif (sprint === \"Elevate\")  investmentCost = 9000;\n\n// ------------------------------------------------------\n// ROI CALCULATION\n// ------------------------------------------------------\nconst annualROI = Number((yearlySavings / investmentCost).toFixed(2));\nconst minROI = Number(Math.max(annualROI, 3.5).toFixed(2));\n\n// ------------------------------------------------------\n// RETURN EVERYTHING FOR REPORT\n// ------------------------------------------------------\nreturn {\n  json: {\n    // ROI\n    hourlyRate,\n    hoursRecovered,\n    yearlySavings,\n    monthlySavings,\n    investmentCost,\n    annualROI,\n    minROI,\n\n    // Revenue\n    revenueRange,\n    annualRevenueNumeric,\n\n    // VEOS / Scoring\n    sprint_recommendation: sprint,\n    operational_intelligence_score: $json.operational_intelligence_score,\n    operational_intelligence_pct: $json.operational_intelligence_pct,\n    identity_level: $json.identity_level,\n    maturity_level: $json.maturity_level,\n    veos_phase_recommendation: $json.veos_phase_recommendation,\n\n    // Pillars\n    weakest_pillar: $json.weakest_pillar,\n    pillar_scores: $json.pillar_scores,\n    pillar_rankings: $json.pillar_rankings,\n\n    // Dimensions\n    dimensions: $json.dimensions,\n\n    // Personal Info\n    name,\n    email,\n    company\n  }\n};\n\n\n"
