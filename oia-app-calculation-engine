      "parameters": {
        "jsCode": "// ===============================\n// Pull contact info from webhook\n// ===============================\nconst body = $node[\"Receiving Answers\"].json.body || {};\n\nconst name = body.name || \"\";\nconst email = body.email || \"\";\nconst company =\n  body.company ||\n  body.company_name ||\n  body.business ||\n  body.businessName ||\n  body.business_name ||\n  \"\";\n\n// ===============================\n// Pull answers from the webhook node\n// Expecting q1 ... q36 as Yes/No\n// ===============================\nconst answers = body;\n\n// ===============================\n// WEIGHT MAP (Critical = 5, Standard = 3, Indicator = 1)\n// ===============================\nconst weights = {\n  1: 5,  2: 3,  3: 1,\n  4: 5,  5: 3,  6: 1,\n  7: 5,  8: 3,  9: 1,\n  10: 5, 11: 3, 12: 1,\n  13: 5, 14: 3, 15: 1,\n  16: 5, 17: 3, 18: 1,\n  19: 5, 20: 3, 21: 1,\n  22: 5, 23: 3, 24: 1,\n  25: 5, 26: 3, 27: 1,\n  28: 5, 29: 3, 30: 1,\n  31: 5, 32: 3, 33: 1,\n  34: 5, 35: 3, 36: 1,\n};\n\n// ===============================\n// NEGATIVE QUESTIONS (Yes = problem)\n// These are flipped: user says \"yes\" → scores 0\n//                    user says \"no\"  → scores points\n// All Critical-tier (weight 5) questions are negative.\n// ===============================\nconst negativeQs = new Set([1,4,7,10,13,16,19,22,25,28,31,34]);\n\n// ===============================\n// Helper: does this answer earn points?\n// For positive questions: \"yes\" = points\n// For negative questions: \"no\"  = points (flipped)\n// ===============================\nfunction isYes(qNumber) {\n  const val = answers[`q${qNumber}`];\n  if (!val) return false;\n  const answeredYes = val.toString().toLowerCase() === \"yes\";\n  return negativeQs.has(qNumber) ? !answeredYes : answeredYes;\n}\n\n// ===============================\n// Helper: score a list of questions\n// ===============================\nfunction scoreGroup(qList) {\n  let score = 0;\n  let max = 0;\n\n  for (const q of qList) {\n    const w = weights[q] || 0;\n    max += w;\n    if (isYes(q)) {\n      score += w;\n    }\n  }\n\n  return { score, max };\n}\n\n// ===============================\n// PILLAR QUESTION GROUPS\n// ===============================\nconst discoverQs = [1,2,3,4,5,6,7,8,9];\nconst designQs   = [10,11,12,13,14,15,16,17,18];\nconst deployQs   = [19,20,21,22,23,24,25,26,27];\nconst optimizeQs = [28,29,30,31,32,33,34,35,36];\n\n// ===============================\n// DIMENSION QUESTION GROUPS\n// ===============================\n// Each dimension has 3 questions\nconst dimensionMap = {\n  decision_clarity:       [1,2,3],\n  workflow_awareness:     [4,5,6],\n  role_understanding:     [7,8,9],\n  workflow_structure:     [10,11,12],\n  tool_integration:       [13,14,15],\n  sop_maturity:           [16,17,18],\n  automation_readiness:   [19,20,21],\n  delegation_reliability: [22,23,24],\n  execution_consistency:  [25,26,27],\n  performance_tracking:   [28,29,30],\n  bottleneck_removal:     [31,32,33],\n  momentum_maintenance:   [34,35,36],\n};\n\n// ===============================\n// SCORE PILLARS\n// ===============================\nconst discover = scoreGroup(discoverQs);\nconst design   = scoreGroup(designQs);\nconst deploy   = scoreGroup(deployQs);\nconst optimize = scoreGroup(optimizeQs);\n\n// Normalize each pillar to 0–25\nfunction normalizeTo25(group) {\n  if (!group.max || group.max === 0) return 0;\n  return Math.round((group.score / group.max) * 25);\n}\n\nfunction pct(group) {\n  if (!group.max || group.max === 0) return 0;\n  return Math.round((group.score / group.max) * 100);\n}\n\nconst discoverNorm = normalizeTo25(discover);\nconst designNorm   = normalizeTo25(design);\nconst deployNorm   = normalizeTo25(deploy);\nconst optimizeNorm = normalizeTo25(optimize);\n\n// ===============================\n// TOTAL SCORE / OI SCORE\n// ===============================\nconst totalScore = discover.score + design.score + deploy.score + optimize.score;\nconst totalMax   = discover.max   + design.max   + deploy.max   + optimize.max;\n\nlet oiScore = 0;\nif (totalMax > 0) {\n  oiScore = Math.round((totalScore / totalMax) * 100); // 0–100\n}\n\n// For backward-style naming compatibility\nconst overallScore = totalScore;\nconst overallPct   = oiScore;\n\n// ===============================\n// EXECUTIVE MATURITY MODEL & IDENTITY & VEOS PHASE\n// ===============================\n// Levels based on oiScore (0–100)\nlet maturityLevel = \"\";\nlet identityLevel = \"\";\nlet veosPhase     = \"\";\n\nif (oiScore <= 20) {\n  maturityLevel = \"Level 1 — Critical\";\n  identityLevel = \"Carrier\";\n  veosPhase     = \"Extract / Discover\";\n} else if (oiScore <= 40) {\n  maturityLevel = \"Level 2 — Developing\";\n  identityLevel = \"Operator\";\n  veosPhase     = \"Design\";\n} else if (oiScore <= 60) {\n  maturityLevel = \"Level 3 — Functional\";\n  identityLevel = \"Architect – System Builder\";\n  veosPhase     = \"Deploy\";\n} else if (oiScore <= 80) {\n  maturityLevel = \"Level 4 — Optimized\";\n  identityLevel = \"Strategist\";\n  veosPhase     = \"Optimize\";\n} else {\n  maturityLevel = \"Level 5 — Intelligent\";\n  identityLevel = \"Prophet Leader\";\n  veosPhase     = \"Scale / Amplify\";\n}\n\n// ===============================\n// PILLAR SCORES OBJECT\n// ===============================\nconst pillarScores = {\n  discover: {\n    raw_score: discover.score,\n    max_score: discover.max,\n    normalized_25: discoverNorm,\n    pct: pct(discover),\n  },\n  design: {\n    raw_score: design.score,\n    max_score: design.max,\n    normalized_25: designNorm,\n    pct: pct(design),\n  },\n  deploy: {\n    raw_score: deploy.score,\n    max_score: deploy.max,\n    normalized_25: deployNorm,\n    pct: pct(deploy),\n  },\n  optimize: {\n    raw_score: optimize.score,\n    max_score: optimize.max,\n    normalized_25: optimizeNorm,\n    pct: pct(optimize),\n  },\n};\n\n// ===============================\n// WEAKEST PILLAR & RANKINGS\n// ===============================\nconst sortedPillars = Object.entries(pillarScores)\n  .sort((a, b) => a[1].normalized_25 - b[1].normalized_25) // weakest → strongest\n  .map(([key]) => key);\n\nconst weakestPillar = sortedPillars[0] || null;\n\n// ===============================\n// SPRINT RECOMMENDATION BASED ON WEAKEST PILLAR\n// discover → Extract\n// design   → Organize\n// deploy   → Activate\n// optimize → Elevate\n// ===============================\nlet sprintRecommendation = \"\";\n\nswitch (weakestPillar) {\n  case \"discover\":\n    sprintRecommendation = \"Extract\";\n    break;\n  case \"design\":\n    sprintRecommendation = \"Organize\";\n    break;\n  case \"deploy\":\n    sprintRecommendation = \"Activate\";\n    break;\n  case \"optimize\":\n    sprintRecommendation = \"Elevate\";\n    break;\n  default:\n    sprintRecommendation = \"\";\n}\n\n// ===============================\n// DIMENSION SCORES\n// ===============================\nconst dimensionScores = {};\nfor (const [dimName, qList] of Object.entries(dimensionMap)) {\n  const result = scoreGroup(qList);\n  dimensionScores[dimName] = {\n    raw_score: result.score,\n    max_score: result.max,\n    pct: pct(result),\n  };\n}\n\n// ===============================\n// RETURN VALUES\n// ===============================\nreturn {\n  json: {\n    // Contact\n    name,\n    email,\n    company,\n\n    // Overall scoring\n    raw_total_score: totalScore,\n    raw_total_max: totalMax,\n    overallScore,          // backwards-friendly name\n    overallPct,            // backwards-friendly name\n    operational_intelligence_score: oiScore,\n    operational_intelligence_pct: oiScore,\n\n    // Executive maturity & identity\n    maturity_level: maturityLevel,\n    identity_level: identityLevel,\n    veos_phase_recommendation: veosPhase,\n\n    // Pillars\n    pillar_scores: pillarScores,\n    weakest_pillar: weakestPillar,\n    pillar_rankings: sortedPillars, // weakest → strongest\n\n    // Sprint recommendation (high-level Extract / Organize / Activate / Elevate)\n    sprint_recommendation: sprintRecommendation,\n\n    // Dimensions (12 capability areas)\n    dimensions: dimensionScores,\n  },\n};\n"
      },
