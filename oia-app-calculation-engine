    {
      "parameters": {
        "jsCode": "// Pull all needed values from scoring engine (Node 1)\nconst overallScore = $json.operational_intelligence_score;\nconst overallPct   = $json.operational_intelligence_pct;\n\nconst maturity     = $json.maturity_level;\nconst identity     = $json.identity_level;\nconst veosPhase    = $json.veos_phase_recommendation;\n\nconst pillarScores = $json.pillar_scores;\nconst weakest      = $json.weakest_pillar;\nconst rankings     = $json.pillar_rankings;\n\nconst dimensions   = $json.dimensions;\n\n// Pull the Sprint from the Switch branch\nconst sprint = $json.sprint_recommendation;\n\n// Return ALL values for later nodes (PDF, Summary, CRM, etc.)\nreturn {\n  score: overallScore,\n  pct: overallPct,\n\n  sprint_recommendation: sprint,\n  maturity_level: maturity,\n  identity_level: identity,\n  veos_phase_recommendation: veosPhase,\n\n  pillar_scores: pillarScores,\n  weakest_pillar: weakest,\n  pillar_rankings: rankings,\n\n  dimensions: dimensions\n};\n"
